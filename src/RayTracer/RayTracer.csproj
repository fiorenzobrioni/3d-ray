<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**</DefaultItemExcludes>
    <!-- The XML summaries of Scene/ become the descriptions of the scene JSON
         Schema (SceneSchema); the rest of the code is not held to doc rules. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1711;CS1734;CS1735;CS0419</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- Intel Open Image Denoise 2.2 (Apache-2.0) native libraries for
         linux-x64, win-x64, osx-x64 and osx-arm64: only the package's native
         assets are used (Denoising/Oidn.cs is the binding). -->
    <PackageReference Include="SimpleImageIO" Version="1.13.0" IncludeAssets="native" />
  </ItemGroup>

  <!-- The package's own image library is not used: keep only OIDN and TBB. -->
  <Target Name="DropSimpleImageIOCore" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="$([System.String]::Copy('%(Filename)').Contains('SimpleImageIOCore'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="$([System.String]::Copy('%(Filename)').Contains('SimpleImageIOCore'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="RayTracer.Tests" />
  </ItemGroup>

</Project>
